{
  "name": "mppwriter",
  "version": "0.4.0",
  "description": "Write and read Microsoft Project .mpp files from TypeScript \u2014 no Java, no .NET, no Project install",
  "license": "MIT",
  "author": "Kevin McAleer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmcaleer/pymppwriter.git",
    "directory": "js"
  },
  "homepage": "https://github.com/kevinmcaleer/pymppwriter",
  "keywords": [
    "mpp",
    "microsoft-project",
    "project-management",
    "gantt",
    "scheduling",
    "ole2",
    "cfb"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
